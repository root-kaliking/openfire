# OpenFire central server configuration. Copy to `.env` and edit.
# All values are optional; defaults are shown below.

# HTTP listen address for the central API + WebSocket server.
HTTP_ADDR=:8080

# PostgreSQL connection string (lib/pq).
DB_URL=postgres://openfire:openfire@localhost:5432/openfire?sslmode=disable

# Redis connection string (go-redis v9), used for session/presence state.
REDIS_URL=redis://localhost:6379/0

# HS256 JWT signing secret. CHANGE IN PRODUCTION. Tokens expire after 7 days.
JWT_SECRET=dev-secret-change-me

# Shared secret that Godot dedicated servers use to authenticate result
# reporting. Also injected into each GS process as OPENFIRE_INTERNAL_TOKEN.
INTERNAL_TOKEN=dev-internal-token

# Host/IP advertised to clients in the match_found WS message (the GS
# listens on 127.0.0.1 by default).
GS_HOST=127.0.0.1

# Port pool for Godot dedicated-server processes.
GS_PORT_MIN=27020
GS_PORT_MAX=27099

# Godot binary used to launch headless dedicated servers. OPENFIRE_GODOT_BIN
# takes precedence; GODOT_BIN is a fallback.
OPENFIRE_GODOT_BIN=godot

# Base URL of this central server, injected into each GS process so it can
# report results back to /internal/matches/{id}/result.
OPENFIRE_CENTRAL_URL=http://127.0.0.1:8080

# How long a player may wait in the matchmaking queue before being evicted.
MATCHMAKING_TIMEOUT=120s

# Path to the SQL migration file (relative to the server working dir).
MIGRATIONS_PATH=migrations/001_init.sql
